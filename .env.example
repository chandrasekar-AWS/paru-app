# Copy this file to .env and fill in real values, then restart the dev server.

# Google Analytics 4 Measurement ID (Admin > Data Streams > your stream), e.g. G-ABC1234XYZ
VITE_GA_ID=

# Contact-form email sender (Gmail + App Password). Same names go in Vercel → Settings → Environment Variables.
SMTP_USER=designadzonex@gmail.com
SMTP_PASS=

# Supabase — used on Vercel only (local `npm run dev` stores data in .local-data/).
# Put these in Vercel → Settings → Environment Variables. NEVER commit the service role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
