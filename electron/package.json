{
  "name": "paru",
  "productName": "Paru",
  "version": "3.0.0",
  "description": "Paru - your always-on AI assistant and agent",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.paru.assistant",
    "productName": "Paru",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-orb.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../agent",
        "to": "paru/agent",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "../ui",
        "to": "paru/ui"
      },
      {
        "from": "../requirements.txt",
        "to": "paru/requirements.txt"
      },
      {
        "from": "../requirements-optional.txt",
        "to": "paru/requirements-optional.txt"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "../ui/assets/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Paru listens for your wake word and voice commands."
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "../ui/assets/icon.png"
    }
  }
}